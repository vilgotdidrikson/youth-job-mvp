# Copy to .env.deletion and fill only with DevStaging values. Never point this
# suite at production. The service-role key stays in the gitignored .env file.
# The suite creates its own throwaway accounts and deletes them again.

# Use http://localhost:3000 to test a local `next dev` started against staging.
DELETION_TEST_APP_URL=https://youth-job-mvp-dev.vercel.app
DELETION_TEST_SUPABASE_URL=https://vwcfjvwfeatvuisojwrh.supabase.co
DELETION_TEST_ANON_KEY=
DELETION_TEST_SERVICE_ROLE_KEY=

# Optional: domain for the generated test addresses (no email is sent).
# DELETION_TEST_EMAIL_DOMAIN=example.com

DELETION_TEST_ALLOW_WRITES=true
